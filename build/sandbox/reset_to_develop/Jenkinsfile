pipeline {
    agent { node env.Node }
    stages {
        stage('Reset branch') {
            steps {
                sh 'git config --global credential.helper cache'
                sh 'git config --global push.default simple'

                checkout([
                    $class: 'GitSCM',
                    branches: [[name: 'sandbox']],
                    extensions: [
                        [$class: 'CloneOption', noTags: true, reference: '', shallow: true]
                    ],
                    submoduleCfg: [],
                    userRemoteConfigs: [
                        [ credentialsId: 'pe-memberdna-test-przemek', url: 'https://bitbucket.bjs.com/scm/an/pe_memberdna.git']
                    ]
                ])
                sh '''
                    git reset --hard origin/develop
                    git config --global user.name "****"
                    git config --global user.email "****@bjs.com"
                    git checkout -b sandbox
                    git push --force --set-upstream origin sandbox
                '''
            }
        }
    }
    post {
        always {
            cleanWs()
        }
    }
}