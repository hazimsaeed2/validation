pipeline {
    agent { node env.Node }
    stages {
        stage('Code promotion') {
            steps {
                sh '''
                    curated_git_branch=$(echo "$GIT_BRANCH"  | sed 's/origin/branch/g')
                    aws s3 sync --delete pe_memberdna s3://memberanalytics-data-out-prod/Code_and_Data_repo/stage/${curated_git_branch}/code/pe_memberdna/
                '''
            }
        }
    }
    post {
        always {
            cleanWs()
        }
    }
}