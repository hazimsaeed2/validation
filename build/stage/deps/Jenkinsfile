pipeline {
    agent { node env.Node }
    stages {
        stage('Dependency promotion') {
            steps {
                sh '''
                    WORKSPACE="$(cut -d'@' -f1 <<<$WORKSPACE)"
                    export PYTHONPATH=$WORKSPACE:

                    python3 -m venv pyspark_venv
                    source pyspark_venv/bin/activate
                    pyspark_venv/bin/pip install --upgrade pip --no-cache-dir
                    python3 -m ensurepip --upgrade
                    pyspark_venv/bin/pip install -r pe_memberdna/requirements.txt --no-cache-dir
                    venv-pack -o pyspark_venv.tar.gz

                    curated_git_branch=$(echo "$GIT_BRANCH"  | sed 's/origin/branch/g')
                    aws s3 cp pyspark_venv.tar.gz s3://memberanalytics-data-out-prod/Code_and_Data_repo/stage/${curated_git_branch}/venv/pyspark_venv.tar.gz
                '''
            }
        }
    }
    post {
        always {
            cleanWs()
        }
    }
}