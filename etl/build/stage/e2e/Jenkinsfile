config_data['data_paths']['recency_lookback_duration']['global'] = 0
if 'local' in config_data['data_paths']['recency_lookback_duration']:
    for k in config_data['data_paths']['recency_lookback_duration']['local'].keys():
        config_data['data_paths']['recency_lookback_duration']['local'][k] = 0

with open(config_path_output, "w") as file:
    documents = yaml.dump(config_data, file)
                            """
                        writeFile file: '_config_cluster_3.py', text: content
                        }

                        sh '''
                            WORKSPACE="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$WORKSPACE:

                            source pyspark_venv/bin/activate
                            python3 _config_cluster_3.py
                            deactivate
                        '''
                        echo "Ran config setup cluster-3 scripts"
                    }
                }
		    }
		}
        stage('Starting 1st Parallel run') {
            parallel {
                stage('Running step-1 on cluster-1') {
                    agent { node env.node_1 }
                    steps {
                        sh '''
                            WORKSPACE="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$WORKSPACE:
                            export SPARK_OPTIONS=" --archives ../../pyspark_venv.tar.gz#environment"
                            export PYSPARK_PYTHON=environment/bin/python
                            export PYSPARK_DRIVER_PYTHON=$WORKSPACE/pyspark_venv/bin/python

                            source pyspark_venv/bin/activate
                            export SPARK_OPTIONS=$SPARK_OPTIONS" --conf spark.sql.broadcastTimeout=-1 --executor-memory=19g --driver-memory=19g --executor-cores=5 --conf spark.sql.shuffle.partitions=800"
                            cd pe_memberdna
                            make -C etl etl_complete_prod_step1_cluster1 SPARK_OPTIONS="$SPARK_OPTIONS" CONFIG_PATH="./configs/config_stage.yaml"
                            deactivate
                        '''
                        echo "Ran step-1 cluster-1 scripts"
                    }
                }
                stage('Running step-1 on cluster-2') {
                    agent { node env.node_2 }
                    steps {
                        sh '''
                            WORKSPACE="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$WORKSPACE:
                            export SPARK_OPTIONS=" --archives ../../pyspark_venv.tar.gz#environment"
                            export PYSPARK_PYTHON=environment/bin/python
                            export PYSPARK_DRIVER_PYTHON=$WORKSPACE/pyspark_venv/bin/python

                            source pyspark_venv/bin/activate
                            export SPARK_OPTIONS=$SPARK_OPTIONS" --conf spark.sql.broadcastTimeout=-1 --executor-memory=18g --driver-memory=18g --executor-cores=5 --conf spark.sql.shuffle.partitions=800"
                            cd pe_memberdna
                            make -C etl etl_complete_prod_step1_cluster2 SPARK_OPTIONS="$SPARK_OPTIONS" CONFIG_PATH="./configs/config_stage.yaml"
                            deactivate
                        '''
                        echo "Ran step-1 cluster-2 script"
                    }
                }
                stage('Running step-1 in cluster-3') {
                    agent { node env.node_3 }
                    steps {
                        sh '''
                            WORKSPACE="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$WORKSPACE:
                            export SPARK_OPTIONS=" --archives ../../pyspark_venv.tar.gz#environment"
                            export PYSPARK_PYTHON=environment/bin/python
                            export PYSPARK_DRIVER_PYTHON=$WORKSPACE/pyspark_venv/bin/python

                            source pyspark_venv/bin/activate
                            export SPARK_OPTIONS=$SPARK_OPTIONS" --conf spark.sql.broadcastTimeout=-1 --executor-memory=24g --driver-memory=24g --executor-cores=5 --conf spark.sql.shuffle.partitions=800"
                            cd pe_memberdna
                            make -C etl etl_complete_prod_step1_cluster3 SPARK_OPTIONS="$SPARK_OPTIONS" CONFIG_PATH="./configs/config_stage.yaml"
                            deactivate
                        '''
                        echo "Ran step-1 cluster-3 script"
                    }
                }
		    }
		}
        stage('Starting 2nd Parallel run') {
            parallel {
                stage('Scaling down the cluster') {
                    agent { node env.node_2 }
                    steps {
                        echo "Scaling down cluster-2"
                        sh '''
                            wrkspce="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$wrkspce:
                            python3 pe_memberdna/scripts/cluster_scaling/scale_by_name.py --target_cluster $NODE_NAME --spot_node_cnt 0 --ondemand_node_cnt 0 --wait 120
                        '''
                        echo "Scaled down cluster-2"
                    }
                }
                stage('Running step-2 on cluster-1') {
                    agent { node env.node_1 }
                    steps {
                        sh '''
                            WORKSPACE="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$WORKSPACE:
                            cd $WORKSPACE
                            unset SPARK_OPTIONS
                            export SPARK_OPTIONS=" --archives ../../pyspark_venv.tar.gz#environment"
                            source pyspark_venv/bin/activate
                            export SPARK_OPTIONS=$SPARK_OPTIONS" --conf spark.sql.broadcastTimeout=-1 --executor-memory=19g --driver-memory=19g --executor-cores=5 --conf spark.sql.shuffle.partitions=800"
                            cd pe_memberdna
                            make -C etl etl_complete_prod_step2_cluster1 SPARK_OPTIONS="$SPARK_OPTIONS" CONFIG_PATH="./configs/config_stage.yaml"
                            deactivate
                        '''
                        echo "Ran step-2 cluster-1 script"
                    }
                }
                stage('Running step-2 on cluster-3') {
                    agent { node env.node_3 }
                    steps {
                        sh '''
                            WORKSPACE="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$WORKSPACE:
                            cd $WORKSPACE
                            unset SPARK_OPTIONS
                            export SPARK_OPTIONS=" --archives ../../pyspark_venv.tar.gz#environment"
                            source pyspark_venv/bin/activate
                            export SPARK_OPTIONS=$SPARK_OPTIONS" --conf spark.sql.broadcastTimeout=-1 --executor-memory=24g --driver-memory=24g --executor-cores=5 --conf spark.sql.shuffle.partitions=800"
                            cd pe_memberdna
                            make -C etl etl_complete_prod_step2_cluster3 SPARK_OPTIONS="$SPARK_OPTIONS" CONFIG_PATH="./configs/config_stage.yaml"
                            deactivate
                        '''
                        echo "Ran step-2 cluster-3 script"
                    }
                }
            }
        }
        stage('Starting 3rd Parallel run') {
            parallel {
                stage('Running step-3 on cluster-1') {
                    agent { node env.node_1 }
                    steps {
                        sh '''
                            WORKSPACE="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$WORKSPACE:
                            cd $WORKSPACE
                            unset SPARK_OPTIONS
                            export SPARK_OPTIONS=" --archives ../../pyspark_venv.tar.gz#environment"
