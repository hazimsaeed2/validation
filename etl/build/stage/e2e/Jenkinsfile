pipeline {
    agent none
    stages {
        stage('Environment setup') {
            parallel {
                stage('Running environment setup on cluster-1') {
                    agent { node env.node_1 }
                    steps {
                        sh '''
                            aws s3 cp --recursive s3://memberanalytics-data-out-prod/v2/stage/code/pe_memberdna pe_memberdna
                            aws s3 cp s3://memberanalytics-data-out-prod/v2/stage/venv/pyspark_venv.tar.gz pyspark_venv.tar.gz
                            mkdir -p pyspark_venv && tar -xf pyspark_venv.tar.gz -C pyspark_venv
                        '''
                        echo "Ran environemnt setup on cluster-1"
                    }
                }
                stage('Running environment setup on cluster-2') {
                    agent { node env.node_2 }
                    steps {
                        sh '''
                            aws s3 cp --recursive s3://memberanalytics-data-out-prod/v2/stage/code/pe_memberdna pe_memberdna
                            aws s3 cp s3://memberanalytics-data-out-prod/v2/stage/venv/pyspark_venv.tar.gz pyspark_venv.tar.gz
                            mkdir -p pyspark_venv && tar -xf pyspark_venv.tar.gz -C pyspark_venv
                        '''
                        echo "Ran environemnt setup on cluster-2"
                    }
                }
                stage('Running environment setup on cluster-3') {
                    agent { node env.node_3 }
                    steps {
                        sh '''
                            aws s3 cp --recursive s3://memberanalytics-data-out-prod/v2/stage/code/pe_memberdna pe_memberdna
                            aws s3 cp s3://memberanalytics-data-out-prod/v2/stage/venv/pyspark_venv.tar.gz pyspark_venv.tar.gz
                            mkdir -p pyspark_venv && tar -xf pyspark_venv.tar.gz -C pyspark_venv
                        '''
                        echo "Ran environemnt setup on cluster-3"
                    }
                }
            }
        }
        stage("Data sync") {
            agent { node env.node_1 }
            steps {
                script {
                    sh  '''
                        aws s3 sync --delete s3://memberanalytics-data-in-prod/Master_Data/ s3://memberanalytics-data-in-prod/stage/ref/Master_Data --exclude PE_Vendors_Site_Article_*.csv --exclude Archive/kantar_itemmaster_hierarchy_data_SAP_20180614.txt --exclude Archive/kantar_itemmaster_hierarchy_data_SAP_20180829.txt --exclude Archive/kantar_storemaster_hierarchy_data_SAP_20180719.txt --exclude Archive/kantar_storemaster_hierarchy_data_SAP_20180829.txt
                        aws s3 sync --delete s3://memberanalytics-data-in-prod/Transaction_Header/ s3://memberanalytics-data-in-prod/stage/ref/Transaction_Header
                        aws s3 sync --delete s3://memberanalytics-data-in-prod/Transaction_Detail/ s3://memberanalytics-data-in-prod/stage/ref/Transaction_Detail
                        aws s3 sync --delete s3://memberanalytics-data-in-prod/Transaction_Payment/ s3://memberanalytics-data-in-prod/stage/ref/Transaction_Payment
                        aws s3 sync --delete s3://memberanalytics-data-in-prod/Membership/ s3://memberanalytics-data-in-prod/stage/ref/Membership --exclude Archive/BCG_Member_Hist.txt --exclude Archive/DataLogix_customer_data_20180829.txt --exclude BCG_Email_Opt_Status_2018_05_01.txt --exclude ls/DataLogix_customer_data.txt --exclude ls/BCG_Member_Hist.txt
                        aws s3 sync --delete s3://memberanalytics-data-in-prod/Other/ s3://memberanalytics-data-in-prod/stage/ref/Other --exclude Promo* --exclude RFM_July2017_Present.csv --exclude people.txt --exclude kantar_itemmaster_hierarchy_data_SAP_20180829.txt --exclude kantar_storemaster_hierarchy_data_SAP_20180829.txt
                        aws s3 sync --delete s3://memberanalytics-data-in-prod/Email_Events/ s3://memberanalytics-data-in-prod/stage/ref/Email_Events
                        aws s3 sync --delete s3://memberanalytics-data-in-prod/ATC/ s3://memberanalytics-data-in-prod/stage/ref/ATC --exclude old/*
                        aws s3 sync --delete s3://memberanalytics-data-in-prod/control_files/ s3://memberanalytics-data-in-prod/stage/ref/control_files
                        aws s3 sync --delete s3://memberanalytics-data-out-prod/CATEGORY_DNA/prod/AH5_CD/CATEGORY_DNA_full/PARQUET/ s3://memberanalytics-data-out-prod/v2/stage/ref/CATEGORY_DNA/prod/AH5_CD/CATEGORY_DNA_full/PARQUET/
                    '''
                    echo "Stage data in sync with prod"
                }
            }
        }
        stage("Cluster scaling") {
            parallel {
                stage('Scaling up cluster -1') {
                    agent { node env.node_1 }
                        steps {
                            script {
                                if (env.cluster_scaling == 'Spot_Nodes') {
                                    echo "Scaling up"
                                    sh  '''
                                        wrkspce="$(cut -d'@' -f1 <<<$WORKSPACE)"
                                        export PYTHONPATH=$wrkspce:
                                        python3 pe_memberdna/scripts/cluster_scaling/scale_by_name.py --target_cluster $NODE_NAME --spot_node_cnt 16 --wait 120
                                    '''
                                        echo "Scaled up cluster-1"
                            }
                        }
                    }
                }
                stage('Scaling up cluster-2') {
                    agent { node env.node_2 }
                        steps {
                            script {
                                if (env.cluster_scaling == 'Spot_Nodes') {
                                    echo "Scaling up"
                                    sh '''
                                        wrkspce="$(cut -d'@' -f1 <<<$WORKSPACE)"
                                        export PYTHONPATH=$wrkspce:
                                        python3 pe_memberdna/scripts/cluster_scaling/scale_by_name.py --target_cluster $NODE_NAME --spot_node_cnt 32 --wait 120
                                    '''
                                    echo "Scaled up cluster-2"
                            }
                        }
                    }
                }
                stage('Scaling up cluster-3') {
                    agent { node env.node_3 }
                        steps {
                            script {
                                if (env.cluster_scaling == 'Spot_Nodes') {
                                    echo "Scaling up"
                                    sh '''
                                        wrkspce="$(cut -d'@' -f1 <<<$WORKSPACE)"
                                        export PYTHONPATH=$wrkspce:
                                        python3 pe_memberdna/scripts/cluster_scaling/scale_by_name.py --target_cluster $NODE_NAME --spot_node_cnt 16 --wait 120
                                        '''
                                    echo "Scaled up cluster-3"
                            }
                        }
                    }
                }
            }
        }
        stage('Starting environment config setup') {
            parallel {
                stage('Running config setup on cluster-1') {
                    agent { node env.node_1 }
                    steps {
                        script {
                            def content = """
import os
import yaml

config_path_input = "pe_memberdna/etl/configs/config.yaml"
config_path_output = "pe_memberdna/etl/configs/config_stage.yaml"

with open(config_path_input) as file:
    config_data = yaml.load(file, Loader=yaml.FullLoader)

git_branch = os.getenv('GIT_BRANCH')

for k in config_data["data_paths"]["source"].keys():
    config_data["data_paths"]["source"][k] = config_data["data_paths"]["source"][k].replace(
        "memberanalytics-data-in-prod", f"memberanalytics-data-in-prod/stage"
    )

for k in config_data["data_paths"]["intermediate"].keys():
    if k == "AH5":
        config_data["data_paths"]["intermediate"][k] = config_data["data_paths"]["intermediate"][k].replace(
            "memberanalytics-data-out-prod/v2", f"memberanalytics-data-out-prod/v2/stage/ref"
        )
    else:
        config_data["data_paths"]["intermediate"][k] = config_data["data_paths"]["intermediate"][k].replace(
            "memberanalytics-data-out-prod/v2", f"memberanalytics-data-out-prod/v2/stage/{git_branch}"
        )

for k in config_data["data_paths"]["sampled"].keys():
    config_data["data_paths"]["sampled"][k] = config_data["data_paths"]["sampled"][k].replace(
        "memberanalytics-data-out-prod/v2", f"memberanalytics-data-out-prod/v2/stage/{git_branch}"
    )

config_data["data_paths"]["dq"] = config_data["data_paths"]["dq"].replace(
    "memberanalytics-data-out-prod/v2", f"memberanalytics-data-out-prod/v2/stage/{git_branch}"
)

config_data["data_paths"]["archived"] = config_data["data_paths"]["dq"].replace(
    "memberanalytics-data-out-prod/v2", f"memberanalytics-data-out-prod/v2/stage/{git_branch}"
)

config_data["validation"]["s3_stat_path"] = config_data["validation"]["s3_stat_path"].replace(
    "memberanalytics-data-out-prod/v2", f"memberanalytics-data-out-prod/v2/stage/{git_branch}"
)

config_data['data_paths']['recency_lookback_duration']['global'] = 0
if 'local' in config_data['data_paths']['recency_lookback_duration']:
    for k in config_data['data_paths']['recency_lookback_duration']['local'].keys():
        config_data['data_paths']['recency_lookback_duration']['local'][k] = 0

with open(config_path_output, "w") as file:
    documents = yaml.dump(config_data, file)
                            """
                        writeFile file: '_config_cluster_1.py', text: content
                        }

                        sh '''
                            WORKSPACE="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$WORKSPACE:

                            source pyspark_venv/bin/activate
                            python3 _config_cluster_1.py
                            deactivate
                        '''
                        echo "Ran config setup cluster-1 scripts"
                    }
                }
                stage('Running config setup on cluster-2') {
                    agent { node env.node_2 }
                    steps {
                        script {
                            def content = """
import os
import yaml

config_path_input = "pe_memberdna/etl/configs/config.yaml"
config_path_output = "pe_memberdna/etl/configs/config_stage.yaml"

with open(config_path_input) as file:
    config_data = yaml.load(file, Loader=yaml.FullLoader)

