                        echo "Ran step-3 cluster-1 script"
                    }
                }
                stage('Running step-3 on cluster-3') {
                    agent { node env.node_3 }
                    steps {
                        sh '''
                            WORKSPACE="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$WORKSPACE:
                            cd $WORKSPACE
                            unset SPARK_OPTIONS
                            export SPARK_OPTIONS=" --archives ../../pyspark_venv.tar.gz#environment"
                            source pyspark_venv/bin/activate
                            export SPARK_OPTIONS=$SPARK_OPTIONS" --conf spark.sql.broadcastTimeout=-1 --executor-memory=24g --driver-memory=24g --executor-cores=5 --conf spark.sql.shuffle.partitions=800"
                            cd pe_memberdna
                            make -C etl etl_complete_prod_step3_cluster3 SPARK_OPTIONS="$SPARK_OPTIONS" CONFIG_PATH="./configs/config_stage.yaml"
                            deactivate
                        '''
                        echo "Ran step-3 cluster-3 script"
                    }
                }
            }
        }
    }
}