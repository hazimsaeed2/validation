pipeline {
    agent none
    stages {
        parallel {
            stage('Running environment setup on cluster-1') {
                agent { node env.node_1 }
                steps {
                    sh '''
                        aws s3 cp --recursive s3://memberanalytics-data-out-prod/v2/prod/code/pe_memberdna pe_memberdna
                        aws s3 cp s3://memberanalytics-data-out-prod/v2/prod/venv/pyspark_venv.tar.gz pyspark_venv.tar.gz
                        tar -xf pyspark_venv.tar.gz
                    '''
                    echo "Ran environemnt setup on cluster-1"
                }
            }
            stage('Running environment setup on cluster-2') {
                agent { node env.node_2 }
                steps {
                    sh '''
                        aws s3 cp --recursive s3://memberanalytics-data-out-prod/v2/prod/code/pe_memberdna pe_memberdna
                        aws s3 cp s3://memberanalytics-data-out-prod/v2/prod/venv/pyspark_venv.tar.gz pyspark_venv.tar.gz
                        tar -xf pyspark_venv.tar.gz
                    '''
                    echo "Ran environemnt setup on cluster-2"
                }
            }
            stage('Running environment setup on cluster-3') {
                agent { node env.node_3 }
                steps {
                    sh '''
                        aws s3 cp --recursive s3://memberanalytics-data-out-prod/v2/prod/code/pe_memberdna pe_memberdna
                        aws s3 cp s3://memberanalytics-data-out-prod/v2/prod/venv/pyspark_venv.tar.gz pyspark_venv.tar.gz
                        tar -xf pyspark_venv.tar.gz
                    '''
                    echo "Ran environemnt setup on cluster-3"
                }
            }
        }
        stage("Cluster scaling") {
            parallel {
                stage('Scaling up cluster -1') {
                    agent { node env.node_1 }
                        steps {
                            script {
                                if (env.cluster_scaling == 'Spot_Nodes') {
                                    echo "Scaling up"
                                    sh  '''
                                        wrkspce="$(cut -d'@' -f1 <<<$WORKSPACE)"
                                        export PYTHONPATH=$wrkspce:
                                        python3 pe_memberdna/scripts/cluster_scaling/scale_by_name.py --target_cluster $NODE_NAME --spot_node_cnt 16 --wait 120
                                    '''
                                        echo "Scaled up cluster-1"
                            }
                        }
                    }
                }
                stage('Scaling up cluster-2') {
                    agent { node env.node_2 }
                        steps {
                            script {
                                if (env.cluster_scaling == 'Spot_Nodes') {
                                    echo "Scaling up"
                                    sh '''
                                        wrkspce="$(cut -d'@' -f1 <<<$WORKSPACE)"
                                        export PYTHONPATH=$wrkspce:
                                        python3 pe_memberdna/scripts/cluster_scaling/scale_by_name.py --target_cluster $NODE_NAME --spot_node_cnt 32 --wait 120
                                    '''
                                    echo "Scaled up cluster-2"
                            }
                        }
                    }
                }
                stage('Scaling up cluster-3') {
                    agent { node env.node_3 }
                        steps {
                            script {
                                if (env.cluster_scaling == 'Spot_Nodes') {
                                    echo "Scaling up"
                                    sh '''
                                        wrkspce="$(cut -d'@' -f1 <<<$WORKSPACE)"
                                        export PYTHONPATH=$wrkspce:
                                        python3 pe_memberdna/scripts/cluster_scaling/scale_by_name.py --target_cluster $NODE_NAME --spot_node_cnt 16 --wait 120
                                        '''
                                    echo "Scaled up cluster-3"
                            }
                        }
                    }
                }
            }
        }
        stage('Starting 1st Parallel run') {
            parallel {
                stage('Running step-1 on cluster-1') {
                    agent { node env.node_1 }
                    steps {
                        sh '''
                            WORKSPACE="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$WORKSPACE:
                            export SPARK_OPTIONS=" --archives ../../pyspark_venv.tar.gz#environment"
                            export PYSPARK_PYTHON=environment/bin/python
                            export PYSPARK_DRIVER_PYTHON=$WORKSPACE/pyspark_venv/bin/python

                            source pyspark_venv/bin/activate
                            export SPARK_OPTIONS=$SPARK_OPTIONS" --conf spark.sql.broadcastTimeout=-1 --executor-memory=19g --driver-memory=19g --executor-cores=5 --conf spark.sql.shuffle.partitions=800"
                            cd pe_memberdna
                            make -C etl etl_complete_prod_step1_cluster1 SPARK_OPTIONS="$SPARK_OPTIONS"
                            deactivate
                        '''
                        echo "Ran step-1 cluster-1 scripts"
                    }
                }
                stage('Running step-1 on cluster-2') {
                    agent { node env.node_2 }
                    steps {
                        sh '''
                            WORKSPACE="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$WORKSPACE:
                            export SPARK_OPTIONS=" --archives ../../pyspark_venv.tar.gz#environment"
                            export PYSPARK_PYTHON=environment/bin/python
                            export PYSPARK_DRIVER_PYTHON=$WORKSPACE/pyspark_venv/bin/python

                            source pyspark_venv/bin/activate
                            export SPARK_OPTIONS=$SPARK_OPTIONS" --conf spark.sql.broadcastTimeout=-1 --executor-memory=18g --driver-memory=18g --executor-cores=5 --conf spark.sql.shuffle.partitions=800"
                            cd pe_memberdna
                            make -C etl etl_complete_prod_step1_cluster2 SPARK_OPTIONS="$SPARK_OPTIONS"
                            deactivate
                        '''
                        echo "Ran step-1 cluster-2 script"
                    }
                }
                stage('Running step-1 in cluster-3') {
                    agent { node env.node_3 }
                    steps {
                        sh '''
                            WORKSPACE="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$WORKSPACE:
                            export SPARK_OPTIONS=" --archives ../../pyspark_venv.tar.gz#environment"
                            export PYSPARK_PYTHON=environment/bin/python
                            export PYSPARK_DRIVER_PYTHON=$WORKSPACE/pyspark_venv/bin/python

                            source pyspark_venv/bin/activate
                            export SPARK_OPTIONS=$SPARK_OPTIONS" --conf spark.sql.broadcastTimeout=-1 --executor-memory=24g --driver-memory=24g --executor-cores=5 --conf spark.sql.shuffle.partitions=800"
                            cd pe_memberdna
                            make -C etl etl_complete_prod_step1_cluster3 SPARK_OPTIONS="$SPARK_OPTIONS"
                            deactivate
                        '''
                        echo "Ran step-1 cluster-3 script"
                    }
                }
		    }
		}
        stage('Starting 2nd Parallel run') {
            parallel {
                stage('Scaling down the cluster') {
                    agent { node env.node_2 }
                    steps {
                        echo "Scaling down cluster-2"
                        sh '''
                            wrkspce="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$wrkspce:
                            python3 pe_memberdna/scripts/cluster_scaling/scale_by_name.py --target_cluster $NODE_NAME --spot_node_cnt 0 --ondemand_node_cnt 0 --wait 120
                        '''
                        echo "Scaled down cluster-2"
                    }
                }
                stage('Running step-2 on cluster-1') {
                    agent { node env.node_1 }
                    steps {
                        sh '''
                            WORKSPACE="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$WORKSPACE:
                            cd $WORKSPACE
                            unset SPARK_OPTIONS
                            export SPARK_OPTIONS=" --archives ../../pyspark_venv.tar.gz#environment"
                            source pyspark_venv/bin/activate
                            export SPARK_OPTIONS=$SPARK_OPTIONS" --conf spark.sql.broadcastTimeout=-1 --executor-memory=19g --driver-memory=19g --executor-cores=5 --conf spark.sql.shuffle.partitions=800"
                            cd pe_memberdna
                            make -C etl etl_complete_prod_step2_cluster1 SPARK_OPTIONS="$SPARK_OPTIONS"
                            deactivate
                        '''
                        echo "Ran step-2 cluster-1 script"
                    }
                }
                stage('Running step-2 on cluster-3') {
                    agent { node env.node_3 }
                    steps {
                        sh '''
                            WORKSPACE="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$WORKSPACE:
                            cd $WORKSPACE
                            unset SPARK_OPTIONS
                            export SPARK_OPTIONS=" --archives ../../pyspark_venv.tar.gz#environment"
                            source pyspark_venv/bin/activate
                            export SPARK_OPTIONS=$SPARK_OPTIONS" --conf spark.sql.broadcastTimeout=-1 --executor-memory=24g --driver-memory=24g --executor-cores=5 --conf spark.sql.shuffle.partitions=800"
                            cd pe_memberdna
                            make -C etl etl_complete_prod_step2_cluster3 SPARK_OPTIONS="$SPARK_OPTIONS"
                            deactivate
                        '''
                        echo "Ran step-2 cluster-3 script"
                    }
                }
            }
        }
        stage('Starting 3rd Parallel run') {
            parallel {
                stage('Running step-3 on cluster-1') {
                    agent { node env.node_1 }
                    steps {
                        sh '''
                            WORKSPACE="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$WORKSPACE:
                            cd $WORKSPACE
                            unset SPARK_OPTIONS
                            export SPARK_OPTIONS=" --archives ../../pyspark_venv.tar.gz#environment"
                            source pyspark_venv/bin/activate
                            export SPARK_OPTIONS=$SPARK_OPTIONS" --conf spark.sql.broadcastTimeout=-1 --executor-memory=19g --driver-memory=19g --executor-cores=5 --conf spark.sql.shuffle.partitions=800"
                            cd pe_memberdna
                            make -C etl etl_complete_prod_step3_cluster1 SPARK_OPTIONS="$SPARK_OPTIONS"
                            deactivate
                        '''
                        echo "Ran step-3 cluster-1 script"
                    }
                }
                stage('Running step-3 on cluster-3') {
                    agent { node env.node_3 }
                    steps {
                        sh '''
                            WORKSPACE="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$WORKSPACE:
                            cd $WORKSPACE
                            unset SPARK_OPTIONS
                            export SPARK_OPTIONS=" --archives ../../pyspark_venv.tar.gz#environment"
                            source pyspark_venv/bin/activate
                            export SPARK_OPTIONS=$SPARK_OPTIONS" --conf spark.sql.broadcastTimeout=-1 --executor-memory=24g --driver-memory=24g --executor-cores=5 --conf spark.sql.shuffle.partitions=800"
                            cd pe_memberdna
                            make -C etl etl_complete_prod_step3_cluster3 SPARK_OPTIONS="$SPARK_OPTIONS"
                            deactivate
                        '''
                        echo "Ran step-3 cluster-3 script"
                    }
                }
            }
        }
    }
}