pipeline {
    agent none
    stages {
        parallel {
            stage('Running environment setup on cluster-1') {
                agent { node env.node_1 }
                steps {
                    sh '''
                        aws s3 cp s3://memberanalytics-data-out-prod/v2/stage/${GIT_BRANCH}/code/pe_memberdna pe_memberdna
                        aws s3 cp s3://memberanalytics-data-out-prod/v2/stage/${GIT_BRANCH}/venv/pyspark_venv.tar.gz pyspark_venv.tar.gz
                        tar -xf pyspark_venv.tar.gz
                    '''
                    echo "Ran environemnt setup on cluster-1"
                }
            }
            stage('Running environment setup on cluster-2') {
                agent { node env.node_2 }
                steps {
                    sh '''
                        aws s3 cp s3://memberanalytics-data-out-prod/v2/stage/${GIT_BRANCH}/code/pe_memberdna pe_memberdna
                        aws s3 cp s3://memberanalytics-data-out-prod/v2/stage/${GIT_BRANCH}/venv/pyspark_venv.tar.gz pyspark_venv.tar.gz
                        tar -xf pyspark_venv.tar.gz
                    '''
                    echo "Ran environemnt setup on cluster-2"
                }
            }
        }
        stage("Data sync") {
            agent { node env.node_1 }
            steps {
                script {
                    sh  '''
                        aws s3 sync --delete s3://memberanalytics-data-out-prod/pipelined_intermediates/ s3://memberanalytics-data-out-prod/v2/stage/ref/pipelined_intermediates
                    '''
                    echo "Stage data in sync with prod"
                }
            }
        }
        stage("Cluster scaling") {
            parallel {
                stage('Scaling up cluster -1') {
                    agent { node env.node_1 }
                        steps {
                            script {
                                if (env.cluster_scaling == 'Spot_Nodes') {
                                    echo "Scaling up"
                                    sh  '''
                                        wrkspce="$(cut -d'@' -f1 <<<$WORKSPACE)"
                                        export PYTHONPATH=$wrkspce:
                                        python3 pe_memberdna/scripts/cluster_scaling/scale_by_name.py --target_cluster $NODE_NAME --spot_node_cnt 16 --wait 120
                                    '''
                                        echo "Scaled up cluster-1"
                            }
                        }
                    }
                }
                stage('Scaling up cluster-2') {
                    agent { node env.node_2 }
                        steps {
                            script {
                                if (env.cluster_scaling == 'Spot_Nodes') {
                                    echo "Scaling up"
                                    sh '''
                                        wrkspce="$(cut -d'@' -f1 <<<$WORKSPACE)"
                                        export PYTHONPATH=$wrkspce:
                                        python3 pe_memberdna/scripts/cluster_scaling/scale_by_name.py --target_cluster $NODE_NAME --spot_node_cnt 32 --wait 120
                                    '''
                                    echo "Scaled up cluster-2"
                            }
                        }
                    }
                }
            }
        }
        stage('Starting environment config setup') {
            parallel {
                stage('Running config setup on cluster-1') {
                    agent { node env.node_1 }
                    steps {
                        script {
                            def content = """
import os
import yaml

config_path_input = "pe_memberdna/dna/category/configs/reqs.yaml"
config_path_output = "pe_memberdna/dna/category/configs/reqs_stage.yaml"

git_branch = os.getenv('GIT_BRANCH')

with open(config_path_input) as file:
    config_data = yaml.load(file, Loader=yaml.FullLoader)

config_data['detail']['path'] = config_data['detail']['path'].replace(
    'v2/pipelined_intermediates', 'v2/stage/pipelined_intermediates'
)
config_data['member']['path'] = config_data['member']['path'].replace(
    'v2/pipelined_intermediates', 'v2/stage/pipelined_intermediates'
)
config_data['item']['path'] = config_data['item']['path'].replace(
    'v2/pipelined_intermediates', 'v2/stage/pipelined_intermediates'
)
config_data['member_extended']['path'] = config_data['member_extended']['path'].replace(
    'v2/pipelined_intermediates', 'v2/stage/pipelined_intermediates'
)
config_data['exclusion']['path'] = config_data['exclusion']['path'].replace(
    'v2/exclusions', f'v2/stage/{git_branch}/exclusions'
)
config_data['out']['path'] = config_data['out']['path'].replace(
    'v2/CATEGORY_DNA', f'v2/stage/{git_branch}CATEGORY_DNA'
)

config_data['recency_lookback_duration']['global'] = 0
if 'local' in config_data['recency_lookback_duration']:
    for k in config_data['recency_lookback_duration']['local'].keys():
        config_data['recency_lookback_duration']['local'][k] = 0

with open(config_path_output, "w") as file:
    documents = yaml.dump(config_data, file)

config_path_input = "pe_memberdna/dna/category/configs/brand_excl_conf.yaml"
config_path_output = "pe_memberdna/dna/category/configs/brand_excl_conf_stage.yaml"

git_branch = os.getenv('GIT_BRANCH')

with open(config_path_input) as file:
    config_data = yaml.load(file, Loader=yaml.FullLoader)

config_data['paths']['brand'] = config_data['paths']['brand'].replace(
    'v2/pipelined_intermediates', 'v2/stage/ref/pipelined_intermediates'
)
config_data['paths']['item'] = config_data['paths']['item'].replace(
    'v2/pipelined_intermediates', 'v2/stage/ref/pipelined_intermediates'
)
config_data['paths']['cat_dna'] = config_data['paths']['cat_dna'].replace(
    'v2/CATEGORY_DNA', 'v2/stage/ref/CATEGORY_DNA'
)
config_data['paths']['transactions'] = config_data['paths']['transactions'].replace(
    'v2/pipelined_intermediates', 'v2/stage/ref/pipelined_intermediates'
)
config_data['paths']['exclusions'] = config_data['paths']['exclusions'].replace(
    'v2/exclusions', 'v2/stage/ref/exclusions'
)
config_data['paths']['output'] = config_data['paths']['output'].replace(
    'v2/exclusions', f'v2/stage/{git_branch}/exclusions'
)
with open(config_path_output, "w") as file:
    documents = yaml.dump(config_data, file)
                            """
                        writeFile file: '_config_cluster_1.py', text: content
                        }

                        sh '''
                            WORKSPACE="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$WORKSPACE:

                            source pyspark_venv/bin/activate
                            python3 _config_cluster_1
                            deactivate
                        '''
                        echo "Ran config setup cluster-1 scripts"
                    }
                }
                stage('Running config setup on cluster-3') {
                    agent { node env.node_2 }
                    steps {
                        script {
                            def content = """
import os
import yaml

config_path_input = "pe_memberdna/dna/category/configs/reqs.yaml"
config_path_output = "pe_memberdna/dna/category/configs/reqs_stage.yaml"

git_branch = os.getenv('GIT_BRANCH')

with open(config_path_input) as file:
    config_data = yaml.load(file, Loader=yaml.FullLoader)

config_data['detail']['path'] = config_data['detail']['path'].replace(
    'v2/pipelined_intermediates', 'v2/stage/pipelined_intermediates'
)
config_data['member']['path'] = config_data['member']['path'].replace(
    'v2/pipelined_intermediates', 'v2/stage/pipelined_intermediates'
)
config_data['item']['path'] = config_data['item']['path'].replace(
    'v2/pipelined_intermediates', 'v2/stage/pipelined_intermediates'
)
config_data['member_extended']['path'] = config_data['member_extended']['path'].replace(
    'v2/pipelined_intermediates', 'v2/stage/pipelined_intermediates'
)
config_data['exclusion']['path'] = config_data['exclusion']['path'].replace(
    'v2/exclusions', f'v2/stage/{git_branch}/exclusions'
)
config_data['out']['path'] = config_data['out']['path'].replace(
    'v2/CATEGORY_DNA', f'v2/stage/{git_branch}CATEGORY_DNA'
)

config_data['recency_lookback_duration']['global'] = 0
if 'local' in config_data['recency_lookback_duration']:
    for k in config_data['recency_lookback_duration']['local'].keys():
        config_data['recency_lookback_duration']['local'][k] = 0

with open(config_path_output, "w") as file:
    documents = yaml.dump(config_data, file)

config_path_input = "pe_memberdna/dna/category/configs/brand_excl_conf.yaml"
config_path_output = "pe_memberdna/dna/category/configs/brand_excl_conf_stage.yaml"

git_branch = os.getenv('GIT_BRANCH')

with open(config_path_input) as file:
    config_data = yaml.load(file, Loader=yaml.FullLoader)

config_data['paths']['brand'] = config_data['paths']['brand'].replace(
    'v2/pipelined_intermediates', 'v2/stage/ref/pipelined_intermediates'
)
config_data['paths']['item'] = config_data['paths']['item'].replace(
    'v2/pipelined_intermediates', 'v2/stage/ref/pipelined_intermediates'
)
config_data['paths']['cat_dna'] = config_data['paths']['cat_dna'].replace(
    'v2/CATEGORY_DNA', 'v2/stage/ref/CATEGORY_DNA'
)
config_data['paths']['transactions'] = config_data['paths']['transactions'].replace(
    'v2/pipelined_intermediates', 'v2/stage/ref/pipelined_intermediates'
)
config_data['paths']['exclusions'] = config_data['paths']['exclusions'].replace(
    'v2/exclusions', 'v2/stage/ref/exclusions'
)
config_data['paths']['output'] = config_data['paths']['output'].replace(
    'v2/exclusions', f'v2/stage/{git_branch}/exclusions'
)
with open(config_path_output, "w") as file:
    documents = yaml.dump(config_data, file)
                            """
                        writeFile file: '_config_cluster_2.py', text: content
                        }

                        sh '''
                            WORKSPACE="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$WORKSPACE:

                            source pyspark_venv/bin/activate
                            python3 _config_cluster_2.py
                            deactivate
                        '''
                        echo "Ran config setup cluster-2 scripts"
                    }
                }
            }
		}
        stage('Starting 0th (exclusions) Parallel run') {
            parallel {
                stage('Running step-1 on cluster-1') {
                    agent { node env.node_1 }
                    steps {
                        sh '''
                            WORKSPACE="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$WORKSPACE:
                            export SPARK_OPTIONS=" --archives ../../../pyspark_venv.tar.gz#environment"
                            export PYSPARK_PYTHON=environment/bin/python
                            export PYSPARK_DRIVER_PYTHON=$WORKSPACE/pyspark_venv/bin/python

                            source pyspark_venv/bin/activate
                            python3 _config_cluster_1.py
                            cd pe_memberdna/dna/category
                            spark-submit ${SPARK_OPTIONS} scripts/brand_exclusions.py --config_path "./configs/brand_excl_conf_stage.yaml" > brand_exclusions_prod.log 2>&1
                        '''
                        echo "Ran step-1 cluster-1 script"
                    }
                }
        stage('Starting 1st Parallel run') {
            parallel {
                stage('Running step-1 on cluster-1') {
                    agent { node env.node_1 }
                    steps {
                        script {
                            def content = """

import os
import yaml
import datetime

for yaml_path in [
   'pe_memberdna/dna/category/configs/square_AH4.yaml',
   'pe_memberdna/dna/category/configs/square_AH5.yaml',
   'pe_memberdna/dna/category/configs/square_article.yaml',
   'pe_memberdna/dna/category/configs/square_brand.yaml'
   ]:

   with open(yaml_path) as config_file:
      config = yaml.load(config_file)

   end_date = os.environ['end']

   if end_date == 'automatic':
      print('end_date and start_date calculated automatically')
   else:
      datetime_object = datetime.datetime.strptime(end_date, '%Y-%m-%d')
      start_date = '{:%Y-%m-%d}'.format(
         datetime_object - datetime.timedelta(365+1)
      )

      print('setting start_date to ' + start_date)
      print('setting end_date to ' + end_date)

      config['end'] = end_date
      config['start'] = start_date

   with open(yaml_path,'w') as config_file:
      yaml.dump(config, config_file)

"""
                writeFile file: '_config_cluster_1.py', text: content
                }
                        sh '''
                            WORKSPACE="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$WORKSPACE:
                            export SPARK_OPTIONS=" --archives ../../../pyspark_venv.tar.gz#environment"
                            export PYSPARK_PYTHON=environment/bin/python
                            export PYSPARK_DRIVER_PYTHON=$WORKSPACE/pyspark_venv/bin/python

                            source pyspark_venv/bin/activate
                            python3 _config_cluster_1.py
                            cd pe_memberdna/dna/category
                            spark-submit ${SPARK_OPTIONS} --num-executors=56 --conf spark.executor.cores=5 --conf spark.driver.cores=5 --conf spark.executor.memory=37g --conf spark.executor.memoryOverhead=5g --conf spark.driver.memoryOverhead=5g --conf spark.driver.memory=37g --conf spark.driver.extraJavaOptions=-XX:+UseG1GC --conf spark.executor.extraJavaOptions=-XX:+UseG1GC --conf spark.dynamicAllocation.enabled=false --conf spark.sql.adaptive.enabled=true --conf spark.serializer=org.apache.spark.serializer.KryoSerializer category_square/run.py --prod-mode --full-mode --config_path ./configs/square_AH4.yaml --reqs_path ./config/req_stage.yaml > AH4_full_prod.log 2>&1
                        '''
                        echo "Ran step-1 cluster-1 script"
                    }
                }
                stage('Running step-1 on cluster-3') {
                    agent { node env.node_2 }
                    steps {
                        script {
                            def content = """

import os
import yaml
import datetime

for yaml_path in [
   'pe_memberdna/dna/category/configs/square_AH4.yaml',
   'pe_memberdna/dna/category/configs/square_AH5.yaml',
   'pe_memberdna/dna/category/configs/square_article.yaml',
   'pe_memberdna/dna/category/configs/square_brand.yaml'
   ]:

   with open(yaml_path) as config_file:
      config = yaml.load(config_file)

   end_date = os.environ['end']

   if end_date == 'automatic':
      print('end_date and start_date calculated automatically')
   else:
      datetime_object = datetime.datetime.strptime(end_date, '%Y-%m-%d')
      start_date = '{:%Y-%m-%d}'.format(
         datetime_object - datetime.timedelta(365+1)
      )

      print('setting start_date to ' + start_date)
      print('setting end_date to ' + end_date)

      config['end'] = end_date
      config['start'] = start_date

   with open(yaml_path,'w') as config_file:
      yaml.dump(config, config_file)

"""
                writeFile file: '_config_cluster_3.py', text: content
                }
                        sh '''
                            WORKSPACE="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$WORKSPACE:
                            export SPARK_OPTIONS=" --archives ../../../pyspark_venv.tar.gz#environment"
                            export PYSPARK_PYTHON=environment/bin/python
                            export PYSPARK_DRIVER_PYTHON=$WORKSPACE/pyspark_venv/bin/python

                            source pyspark_venv/bin/activate
                            python3 _config_cluster_1.py
                            cd pe_memberdna/dna/category
                            spark-submit ${SPARK_OPTIONS} --num-executors=56 --conf spark.executor.cores=5 --conf spark.driver.cores=5 --conf spark.executor.memory=37g --conf spark.executor.memoryOverhead=5g --conf spark.driver.memoryOverhead=5g --conf spark.driver.memory=37g --conf spark.driver.extraJavaOptions=-XX:+UseG1GC --conf spark.executor.extraJavaOptions=-XX:+UseG1GC --conf spark.dynamicAllocation.enabled=false --conf spark.sql.adaptive.enabled=true --conf spark.serializer=org.apache.spark.serializer.KryoSerializer category_square/run.py --prod-mode --full-mode --config_path configs/square_AH5.yaml --reqs_path ./config/req_stage.yaml > AH5_full_prod.log 2>&1
                        '''
                        echo "Ran step-1 cluster-3 script"
                    }
                }
            }
        }
        stage('Starting 2nd Parallel run') {
            parallel {
                stage('Running step-2 on cluster-1') {
                    agent { node env.node_1 }
                    steps {
                        sh '''
                            WORKSPACE="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$WORKSPACE:
                            cd $WORKSPACE
                            unset SPARK_OPTIONS
                            export SPARK_OPTIONS=" --archives ../../../pyspark_venv.tar.gz#environment"
                            source pyspark_venv/bin/activate

                            cd pe_memberdna/dna/category
                            spark-submit ${SPARK_OPTIONS} --executor-memory=14g --executor-cores=4 category_square/run.py --prod-mode --full-mode --config_path configs/square_article.yaml --reqs_path ./config/req_stage.yaml > article_full_prod.log 2>&1
                        '''
                        echo "Ran step-3 cluster-1 script"
                    }
                }
                stage('Scaling down the cluster-3') {
                    agent { node env.node_2 }
                    steps {
                        echo "Scaling down cluster-3"
                        sh '''
                            wrkspce="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$wrkspce:
                            python3 pe_memberdna/scripts/cluster_scaling/scale_by_name.py --target_cluster $NODE_NAME --ondemand_node_cnt 0 --spot_node_cnt 0 --wait 120
                            rm -rf $wrkspce/*
                        '''
                        echo "Scaled down cluster-3"
                    }
                }
            }
        }
    }
}