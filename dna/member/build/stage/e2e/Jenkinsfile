    "v2/STATS", f"v2/stage/{git_branch}/STATS"
)

config_data["paths"]["input"]["mbr_basic_path"] = config_data["paths"]["input"]["mbr_basic_path"].replace(
    "Membership/PE_Membership_Mstr_YYYYmmdd.csv", "stage/ref/Membership/PE_Membership_Mstr_YYYYmmdd.csv"
