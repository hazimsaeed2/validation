with open(config_path_output, "w") as file:
    documents = yaml.dump(config_data, file)
                            """
                        writeFile file: '_config_cluster_3.py', text: content
                        }

                        sh '''
                            WORKSPACE="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$WORKSPACE:

                            source pyspark_venv/bin/activate
                            python3 _config_cluster_3.py
                            deactivate
                        '''
                        echo "Ran config setup cluster-3 scripts"
                    }
                }
		    }
		}
        stage('Starting 1st Parallel run') {
            parallel {
                stage('Running step-1 on cluster-1') {
                    agent { node env.node_1 }
                    steps {
                        sh '''
                            WORKSPACE="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$WORKSPACE:
                            export SPARK_OPTIONS=" --archives ../../pyspark_venv.tar.gz#environment"
                            export PYSPARK_PYTHON=environment/bin/python
                            export PYSPARK_DRIVER_PYTHON=$WORKSPACE/pyspark_venv/bin/python

                            source pyspark_venv/bin/activate
                            cd pe_memberdna/dna
                            spark-submit ${SPARK_OPTIONS} --conf spark.sql.broadcastTimeout=-1 --driver-memory=19g --executor-memory=19g --executor-cores=5 --conf spark.sql.shufflepartitions=600 --conf spark.network.timeout=10000001s --conf spark.executor.memoryOverhead=4g scripts/generate_transaction_1.py --config_path ./configs/config_stage.yaml
                            spark-submit ${SPARK_OPTIONS} --conf spark.sql.broadcastTimeout=-1 --driver-memory=19g --executor-memory=19g --executor-cores=5 --conf spark.sql.shufflepartitions=600 --conf spark.network.timeout=10000001s --conf spark.executor.memoryOverhead=4g scripts/generate_transaction_3.py --config_path ./configs/config_stage.yaml
                        '''
                        echo "Ran step-1 cluster-1 scripts"
                    }
                }
                stage('Running step-1 on cluster-2') {
                    agent { node env.node_2 }
                    steps {
                        sh '''
                            WORKSPACE="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$WORKSPACE:
                            export SPARK_OPTIONS=" --archives ../../pyspark_venv.tar.gz#environment"
                            export PYSPARK_PYTHON=environment/bin/python
                            export PYSPARK_DRIVER_PYTHON=$WORKSPACE/pyspark_venv/bin/python

                            source pyspark_venv/bin/activate
                            cd pe_memberdna/dna
                            spark-submit ${SPARK_OPTIONS} --conf spark.sql.broadcastTimeout=-1 --driver-memory=18g --executor-memory=18g --executor-cores=5 --conf spark.sql.shufflepartitions=600 --conf spark.network.timeout=10000001s --conf spark.executor.memoryOverhead=4g scripts/generate_coupon_and_digital_1.py --config_path ./configs/config_stage.yaml
                        '''
                        echo "Ran step-1 cluster-2 script"
                    }
                }
                stage('Running step-1 in cluster-3') {
                    agent { node env.node_3 }
                    steps {
                        sh '''
                            WORKSPACE="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$WORKSPACE:
                            export SPARK_OPTIONS=" --archives ../../pyspark_venv.tar.gz#environment"
                            export PYSPARK_PYTHON=environment/bin/python
                            export PYSPARK_DRIVER_PYTHON=$WORKSPACE/pyspark_venv/bin/python

                            source pyspark_venv/bin/activate
                            cd pe_memberdna/dna
                            spark-submit ${SPARK_OPTIONS} --conf spark.sql.broadcastTimeout=-1 --executor-memory=24g --driver-memory=24g --executor-cores=5 --conf spark.sql.shufflepartitions=600 --conf spark.network.timeout=10000001s --conf spark.executor.memoryOverhead=4g scripts/generate_member.py --config_path ./configs/config_stage.yaml
                            spark-submit ${SPARK_OPTIONS} --conf spark.sql.broadcastTimeout=-1 --executor-memory=24g --driver-memory=24g --executor-cores=5 --conf spark.sql.shufflepartitions=600 --conf spark.network.timeout=10000001s --conf spark.executor.memoryOverhead=4g scripts/generate_most_shopped.py --config_path ./configs/config_stage.yaml
                        '''
                        echo "Ran step-1 cluster-3 script"
                    }
                }

		    }
		}
        stage('Starting 2nd Parallel run') {
            parallel {
                stage('Running source etl archiving') {
                    agent { node env.node_2 }
                        steps {
                            script {
                            def content = """

import os
import yaml
import datetime

with open('pe_memberdna/etl/configs/config.yaml') as config_file:
   config = yaml.load(config_file)

max_date = os.environ['max_date']
if max_date == 'automatic':
   print('max_date calculated automatically')
else:
   datetime_object = datetime.datetime.strptime(max_date, '%Y-%m-%d')
   print('setting max_date to ' + str(datetime_object))
   config['club_square_config']['max_date'] = max_date

if os.environ['enable_DQ_checks']=='false':
   config['validation']['table_params']=None

for k in config_data["data_paths"]["source"].keys():
    config_data["data_paths"]["source"][k] = config_data["data_paths"]["source"][k].replace(
        "memberanalytics-data-in-prod", "memberanalytics-data-in-prod/stage"
    )

for k in config_data["data_paths"]["intermediate"].keys():
    config_data["data_paths"]["intermediate"][k] = config_data["data_paths"]["intermediate"][k].replace(
        "memberanalytics-data-out-prod/v2", "memberanalytics-data-out-prod/v2/stage"
    )

for k in config_data["data_paths"]["sampled"].keys():
    config_data["data_paths"]["sampled"][k] = config_data["data_paths"]["sampled"][k].replace(
        "memberanalytics-data-out-prod/v2", "memberanalytics-data-out-prod/v2/stage"
    )

config_data["data_paths"]["dq"] = config_data["data_paths"]["dq"].replace(
    "memberanalytics-data-out-prod/v2", "memberanalytics-data-out-prod/v2/stage"
)

config_data["data_paths"]["archived"] = config_data["data_paths"]["dq"].replace(
    "memberanalytics-data-out-prod/v2", "memberanalytics-data-out-prod/v2/stage"
)

config_data["validation"]["s3_stat_path"] = config_data["validation"]["s3_stat_path"].replace(
    "memberanalytics-data-out-prod/v2", "memberanalytics-data-out-prod/v2/stage"
)

config_data['data_paths']['recency_lookback_duration']['global'] = 0
if 'local' in config_data['data_paths']['recency_lookback_duration']:
    for k in config_data['data_paths']['recency_lookback_duration']['local'].keys():
        config_data['data_paths']['recency_lookback_duration']['local'][k] = 0

with open('pe_memberdna/etl/configs/config_stage.yaml','w') as config_file:
   yaml.dump(config, config_file)

"""
                writeFile file: '_config_etl.py', text: content
                }
                sh '''
                WORKSPACE="$(cut -d'@' -f1 <<<$WORKSPACE)"
                export PYTHONPATH=$WORKSPACE:
                cd $WORKSPACE
                unset SPARK_OPTIONS
                export SPARK_OPTIONS=" --archives ../../pyspark_venv.tar.gz#environment"
                source pyspark_venv/bin/activate
                export SPARK_OPTIONS=$SPARK_OPTIONS" --conf spark.sql.broadcastTimeout=-1 --conf spark.sql.shuffle.partitions=800"

                echo "RUNNING post_source_etl_archiving STARTED"

                python3 _config_etl.py
                make -C ./pe_memberdna/etl post_source_etl_archiving SPARK_OPTIONS="$SPARK_OPTIONS" CONFIG_PATH="./configs/config_stage.yaml"
                echo "RUNNING post_source_etl_archiving FINISHED"
                '''
            }
        }
                stage('Running step-2 on cluster-1') {
                    agent { node env.node_1 }
                    steps {
                        sh '''
                            WORKSPACE="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$WORKSPACE:
                            cd $WORKSPACE
                            unset SPARK_OPTIONS
                            export SPARK_OPTIONS=" --archives ../../pyspark_venv.tar.gz#environment"
                            source pyspark_venv/bin/activate

                            cd pe_memberdna/dna
                            spark-submit ${SPARK_OPTIONS} --conf spark.sql.broadcastTimeout=-1 --driver-memory=19g --executor-memory=19g --executor-cores=5 --conf spark.sql.shufflepartitions=600 --conf spark.network.timeout=10000001s --conf spark.executor.memoryOverhead=4g scripts/generate_transaction_2.py --config_path ./configs/config_stage.yaml
                            spark-submit ${SPARK_OPTIONS} --conf spark.sql.broadcastTimeout=-1 --driver-memory=19g --executor-memory=19g --executor-cores=5 --conf spark.sql.shufflepartitions=600 --conf spark.network.timeout=10000001s --conf spark.executor.memoryOverhead=4g scripts/generate_misc.py --config_path ./configs/config_stage.yaml
                        '''
                        echo "Ran step-2 cluster-1 script"
                    }
                }
                stage('Running step-2 on cluster-3') {
                    agent { node env.node_3 }
                    steps {
                        sh '''
                            WORKSPACE="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$WORKSPACE:
                            cd $WORKSPACE
                            unset SPARK_OPTIONS
                            export SPARK_OPTIONS=" --archives ../../pyspark_venv.tar.gz#environment"
                            source pyspark_venv/bin/activate

                            cd pe_memberdna/dna
                            spark-submit ${SPARK_OPTIONS} --conf spark.sql.broadcastTimeout=-1 --executor-memory=24g --driver-memory=24g --executor-cores=5 --conf spark.sql.shufflepartitions=600 --conf spark.network.timeout=10000001s --conf spark.executor.memoryOverhead=4g scripts/generate_coupon_and_digital_2.py --config_path ./configs/config_stage.yaml
                            spark-submit ${SPARK_OPTIONS} --conf spark.sql.broadcastTimeout=-1 --executor-memory=24g --driver-memory=24g --executor-cores=5 --conf spark.sql.shufflepartitions=600 --conf spark.network.timeout=10000001s --conf spark.executor.memoryOverhead=4g scripts/integrate_acquisition.py --config_path ./configs/config_stage.yaml
                        '''
                        echo "Ran step-2 cluster-3 script"
                    }
                }
            }
        }

        stage('Starting 3rd Parallel run') {
            parallel {
                stage('Scaling down the cluster-2') {
                    agent { node env.node_2 }
                    steps {
                        echo "Scaling down cluster-2"
                        sh '''
                            WORKSPACE="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$WORKSPACE:
                            cd $WORKSPACE
                            unset SPARK_OPTIONS
                            export SPARK_OPTIONS=" --archives ../../pyspark_venv.tar.gz#environment"
                            source pyspark_venv/bin/activate

                            python3 pe_memberdna/scripts/cluster_scaling/scale_by_name.py --target_cluster $NODE_NAME --ondemand_node_cnt 0 --spot_node_cnt 0 --wait 120
                            rm -rf $WORKSPACE/*
                        '''
                        echo "Scaled down cluster-2"
                    }
                }
                stage('Running source etl sampling on cluster-1') {
                    agent { node env.node_1 }
                        steps {
