                            source pyspark_venv/bin/activate

                            cd pe_memberdna/dna
                            spark-submit ${SPARK_OPTIONS} --conf spark.sql.broadcastTimeout=-1 --executor-memory=24g --driver-memory=24g --executor-cores=5 --conf spark.sql.shufflepartitions=600 --conf spark.network.timeout=10000001s --conf spark.executor.memoryOverhead=16g scripts/merge.py --config_path ./configs/config_stage.yaml
                        '''
                        echo "Ran step-3 cluster-3 script"
                    }
                }
            }
        }
    }
}