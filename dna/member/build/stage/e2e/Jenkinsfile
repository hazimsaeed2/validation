                python3 _config_etl.py
                make -C ./pe_memberdna/source_etl post_source_etl_sampling SPARK_OPTIONS="$SPARK_OPTIONS" CONFIG_PATH="./configs/config_stage.yaml"
                echo "RUNNING post_source_etl_sampling FINISHED"

