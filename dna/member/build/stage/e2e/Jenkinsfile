pipeline {
    agent none
    stages {
        stage('Environment setup') {
            parallel {
                stage('Running environment setup on cluster-1') {
                    agent { node env.node_1 }
                    steps {
                        sh '''
                            aws s3 cp --recursive s3://memberanalytics-data-out-prod/Code_and_Data_repo/stage/origin/${GIT_BRANCH}/code/pe_memberdna pe_memberdna
                            aws s3 cp s3://memberanalytics-data-out-prod/Code_and_Data_repo/stage/origin/${GIT_BRANCH}/venv/pyspark_venv.tar.gz pyspark_venv.tar.gz
                            mkdir -p pyspark_venv && tar -xf pyspark_venv.tar.gz -C pyspark_venv
                        '''
                        echo "Ran environemnt setup on cluster-1"
                    }
                }
                stage('Running environment setup on cluster-2') {
                    agent { node env.node_2 }
                    steps {
                        sh '''
                            aws s3 cp --recursive s3://memberanalytics-data-out-prod/Code_and_Data_repo/stage/origin/${GIT_BRANCH}/code/pe_memberdna pe_memberdna
                            aws s3 cp s3://memberanalytics-data-out-prod/Code_and_Data_repo/stage/origin/${GIT_BRANCH}/venv/pyspark_venv.tar.gz pyspark_venv.tar.gz
                            mkdir -p pyspark_venv && tar -xf pyspark_venv.tar.gz -C pyspark_venv
                        '''
                        echo "Ran environemnt setup on cluster-2"
                    }
                }
                stage('Running environment setup on cluster-3') {
                    agent { node env.node_3 }
                    steps {
                        sh '''
                            aws s3 cp --recursive s3://memberanalytics-data-out-prod/Code_and_Data_repo/stage/origin/${GIT_BRANCH}/code/pe_memberdna pe_memberdna
                            aws s3 cp s3://memberanalytics-data-out-prod/Code_and_Data_repo/stage/origin/${GIT_BRANCH}/venv/pyspark_venv.tar.gz pyspark_venv.tar.gz
                            mkdir -p pyspark_venv && tar -xf pyspark_venv.tar.gz -C pyspark_venv
                        '''
                        echo "Ran environemnt setup on cluster-3"
                    }
                }
            }
        }
        stage("Data sync") {
            agent { node env.node_1 }
            steps {
                script {
                    sh  '''
                        aws s3 sync --delete s3://memberanalytics-data-out-prod/AD_HOC/pipelined_intermediates s3://memberanalytics-data-out-prod/Code_and_Data_repo/stage/ref/AD_HOC/pipelined_intermediates
                        aws s3 sync --delete s3://memberanalytics-data-in-prod/Membership/ s3://memberanalytics-data-in-prod/stage/ref/Membership --exclude Archive/BCG_Member_Hist.txt --exclude Archive/DataLogix_customer_data_20180829.txt --exclude BCG_Email_Opt_Status_2018_05_01.txt --exclude ls/DataLogix_customer_data.txt --exclude ls/BCG_Member_Hist.txt
                        aws s3 sync --delete s3://memberanalytics-data-out-prod/pipelined_intermediates/awards s3://memberanalytics-data-out-prod/Code_and_Data_repo/stage/ref/pipelined_intermediates/awards
                        aws s3 sync --delete s3://memberanalytics-data-out-prod/pipelined_intermediates/awards_fiscal s3://memberanalytics-data-out-prod/Code_and_Data_repo/stage/ref/pipelined_intermediates/awards_fiscal
                        aws s3 sync --delete s3://memberanalytics-data-out-prod/pipelined_intermediates/bcg_maps s3://memberanalytics-data-out-prod/Code_and_Data_repo/stage/ref/pipelined_intermediates/bcg_maps
                        aws s3 sync --delete s3://memberanalytics-data-out-prod/pipelined_intermediates/control_files s3://memberanalytics-data-out-prod/Code_and_Data_repo/stage/ref/pipelined_intermediates/control_files
                        aws s3 sync --delete s3://memberanalytics-data-out-prod/pipelined_intermediates/coupon_clip s3://memberanalytics-data-out-prod/Code_and_Data_repo/stage/ref/pipelined_intermediates/coupon_clip
                        aws s3 sync --delete s3://memberanalytics-data-out-prod/pipelined_intermediates/coupon_clip_fiscal s3://memberanalytics-data-out-prod/Code_and_Data_repo/stage/ref/pipelined_intermediates/coupon_clip_fiscal
                        aws s3 sync --delete s3://memberanalytics-data-out-prod/pipelined_intermediates/lookup s3://memberanalytics-data-out-prod/Code_and_Data_repo/stage/ref/pipelined_intermediates/lookup
                        aws s3 sync --delete s3://memberanalytics-data-out-prod/pipelined_intermediates/master s3://memberanalytics-data-out-prod/Code_and_Data_repo/stage/ref/pipelined_intermediates/master
                        aws s3 sync --delete s3://memberanalytics-data-out-prod/pipelined_intermediates/quotient_id s3://memberanalytics-data-out-prod/Code_and_Data_repo/stage/ref/pipelined_intermediates/quotient_id
                        aws s3 sync --delete s3://memberanalytics-data-out-prod/pipelined_intermediates/sampled s3://memberanalytics-data-out-prod/Code_and_Data_repo/stage/ref/pipelined_intermediates/sampled
                        aws s3 sync --delete s3://memberanalytics-data-out-prod/pipelined_intermediates/skeleton s3://memberanalytics-data-out-prod/Code_and_Data_repo/stage/ref/pipelined_intermediates/skeleton
                        aws s3 sync --delete s3://memberanalytics-data-out-prod/pipelined_intermediates/transaction s3://memberanalytics-data-out-prod/Code_and_Data_repo/stage/ref/pipelined_intermediates/transaction
                        aws s3 sync --delete s3://memberanalytics-data-out-prod/pipelined_intermediates/transaction_fiscal s3://memberanalytics-data-out-prod/Code_and_Data_repo/stage/ref/pipelined_intermediates/transaction_fiscal
                    '''
                    echo "Stage data in sync with prod"
                }
            }
        }
        stage("Cluster scaling") {
            parallel {
                stage('Scaling up cluster -1') {
                    agent { node env.node_1 }
                        steps {
                            script {
                                if (env.cluster_scaling == 'Spot_Nodes') {
                                    echo "Scaling up"
                                    sh  '''
                                        wrkspce="$(cut -d'@' -f1 <<<$WORKSPACE)"
                                        export PYTHONPATH=$wrkspce:
                                        python3 pe_memberdna/scripts/cluster_scaling/scale_by_name.py --target_cluster $NODE_NAME --spot_node_cnt 16 --wait 120
                                    '''
                                        echo "Scaled up cluster-1"
                            }
                        }
                    }
                }
                stage('Scaling up cluster-2') {
                    agent { node env.node_2 }
                        steps {
                            script {
                                if (env.cluster_scaling == 'Spot_Nodes') {
                                    echo "Scaling up"
                                    sh '''
                                        wrkspce="$(cut -d'@' -f1 <<<$WORKSPACE)"
                                        export PYTHONPATH=$wrkspce:
                                        python3 pe_memberdna/scripts/cluster_scaling/scale_by_name.py --target_cluster $NODE_NAME --spot_node_cnt 32 --wait 120
                                    '''
                                    echo "Scaled up cluster-2"
                            }
                        }
                    }
                }
                stage('Scaling up cluster-3') {
                    agent { node env.node_3 }
                        steps {
                            script {
                                if (env.cluster_scaling == 'Spot_Nodes') {
                                    echo "Scaling up"
                                    sh '''
                                        wrkspce="$(cut -d'@' -f1 <<<$WORKSPACE)"
                                        export PYTHONPATH=$wrkspce:
                                        python3 pe_memberdna/scripts/cluster_scaling/scale_by_name.py --target_cluster $NODE_NAME --spot_node_cnt 16 --wait 120
                                        '''
                                    echo "Scaled up cluster-3"
                            }
                        }
                    }
                }
            }
        }
        stage('Starting environment config setup') {
            parallel {
                stage('Running config setup on cluster-1') {
                    agent { node env.node_1 }
                    steps {
                        script {
                            def content = """
import os
import yaml

config_path_input = "pe_memberdna/dna/member/configs/config.yaml"
config_path_output = "pe_memberdna/dna/member/configs/config_stage.yaml"

git_branch = os.getenv('GIT_BRANCH')

with open(config_path_input) as file:
    config_data = yaml.load(file, Loader=yaml.Loader)

config_data["paths"]["input"]["dir"] = config_data["paths"]["input"]["dir"].replace(
    "v2/pipelined_intermediates", "v2/stage/ref/pipelined_intermediates"
)

config_data["paths"]["input"]["s3_stat_path"] = config_data["paths"]["input"]["s3_stat_path"].replace(
    "v2/STATS", f"v2/stage/{git_branch}/STATS"
)

config_data["paths"]["input"]["mbr_basic_path"] = config_data["paths"]["input"]["mbr_basic_path"].replace(
    "Membership/PE_Membership_Mstr_YYYYmmdd.csv", "stage/ref/Membership/PE_Membership_Mstr_YYYYmmdd.csv"
)

config_data["paths"]["output"]["dir"] = config_data["paths"]["output"]["dir"].replace(
    "v2/CUBES", f"v2/stage/{git_branch}/CUBES"
)

config_data["paths"]["output"]["s3_stat_path"] = config_data["paths"]["output"]["s3_stat_path"].replace(
    "v2/STATS", f"v2/stage/{git_branch}/STATS"
)

config_data['params']['recency_lookback_duration']['global'] = 0
if 'local' in config_data['params']['recency_lookback_duration']:
    for k in config_data['params']['recency_lookback_duration']['local'].keys():
        config_data['params']['recency_lookback_duration']['local'][k] = 0

with open(config_path_output, "w") as file:
    documents = yaml.dump(config_data, file)
                            """
                        writeFile file: '_config_cluster_1.py', text: content
                        }

                        sh '''
                            WORKSPACE="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$WORKSPACE:

                            source pyspark_venv/bin/activate
                            python3 _config_cluster_1.py
                            deactivate
                        '''
                        echo "Ran config setup cluster-1 scripts"
                    }
                }
                stage('Running config setup on cluster-2') {
                    agent { node env.node_2 }
                    steps {
                        script {
                            def content = """
import os
import yaml

config_path_input = "pe_memberdna/dna/member/configs/config.yaml"
config_path_output = "pe_memberdna/dna/member/configs/config_stage.yaml"

git_branch = os.getenv('GIT_BRANCH')

with open(config_path_input) as file:
    config_data = yaml.load(file, Loader=yaml.Loader)

config_data["paths"]["input"]["dir"] = config_data["paths"]["input"]["dir"].replace(
    "v2/pipelined_intermediates", "v2/stage/ref/pipelined_intermediates"
)

config_data["paths"]["input"]["s3_stat_path"] = config_data["paths"]["input"]["s3_stat_path"].replace(
    "v2/STATS", f"v2/stage/{git_branch}/STATS"
)

config_data["paths"]["input"]["mbr_basic_path"] = config_data["paths"]["input"]["mbr_basic_path"].replace(
    "Membership/PE_Membership_Mstr_YYYYmmdd.csv", "stage/ref/Membership/PE_Membership_Mstr_YYYYmmdd.csv"
)

config_data["paths"]["output"]["dir"] = config_data["paths"]["output"]["dir"].replace(
    "v2/CUBES", f"v2/stage/{git_branch}/CUBES"
)

config_data["paths"]["output"]["s3_stat_path"] = config_data["paths"]["output"]["s3_stat_path"].replace(
    "v2/STATS", f"v2/stage/{git_branch}/STATS"
)

config_data['params']['recency_lookback_duration']['global'] = 0
if 'local' in config_data['params']['recency_lookback_duration']:
    for k in config_data['params']['recency_lookback_duration']['local'].keys():
        config_data['params']['recency_lookback_duration']['local'][k] = 0

with open(config_path_output, "w") as file:
    documents = yaml.dump(config_data, file)
                            """
                        writeFile file: '_config_cluster_2.py', text: content
                        }

                        sh '''
                            WORKSPACE="$(cut -d'@' -f1 <<<$WORKSPACE)"
                            export PYTHONPATH=$WORKSPACE:

                            source pyspark_venv/bin/activate
                            python3 _config_cluster_2.py
                            deactivate
                        '''
                        echo "Ran config setup cluster-2 scripts"
                    }
                }
                stage('Running config setup on cluster-3') {
                    agent { node env.node_3 }
                    steps {
                        script {
                            def content = """
import os
import yaml

config_path_input = "pe_memberdna/dna/member/configs/config.yaml"
config_path_output = "pe_memberdna/dna/member/configs/config_stage.yaml"

git_branch = os.getenv('GIT_BRANCH')

with open(config_path_input) as file:
    config_data = yaml.load(file, Loader=yaml.Loader)

config_data["paths"]["input"]["dir"] = config_data["paths"]["input"]["dir"].replace(
    "v2/pipelined_intermediates", "v2/stage/ref/pipelined_intermediates"
)

